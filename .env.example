# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/meditriage
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/meditriage
MONGO_URI=mongodb://127.0.0.1:27017/meditriage

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=7d

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# ─── CORS (your frontend URL, no trailing slash) ──────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Public app URL (used to build share links) ───────────────────────────────
APP_URL=http://localhost:5000
